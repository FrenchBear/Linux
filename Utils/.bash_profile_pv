#!/bin/sh

#export PATH=~/Utils:$PATH

if [ -d /usr/share/dotnet ]; then
echo "DOTNET configured (shared)"
export PATH=$PATH:/usr/share/dotnet
export DOTNET_ROOT=/usr/share/dotnet
export DOTNET_CLI_TELEMETRY_OPTOUT=1
for s in `dotnet --list-sdks | sed 's/..usr.share.dotnet.sdk.//'`
do
  echo "  $s"
done
elif [ -d /lib/dotnet ]; then
echo "DOTNET configured (lib)"
export DOTNET_ROOT=/usr/lib/dotnet
export DOTNET_CLI_TELEMETRY_OPTOUT=1
for s in `dotnet --list-sdks | sed -e 's/..usr.lib.dotnet.sdk.//'`
do
  echo "  $s"
done
elif [ -d ~/dotnet ]; then
echo "DOTNET configured (local)"
export PATH=$PATH:$HOME/dotnet
export DOTNET_ROOT=$HOME/dotnet
export DOTNET_CLI_TELEMETRY_OPTOUT=1
fi

if [ -d /usr/lib/go ]; then
echo "GO configured (lib)"
export GOROOT=/usr/lib/go
export PATH=$PATH:$GOROOT/bin
echo " " `go version|sed -e s'/go version //' -e s'/ linux.amd64//' -e s'/go/go /'`
fi

if [ -d /usr/local/go ]; then
echo "GO configured (local)"
export GOROOT=/usr/local/go
export PATH=$PATH:$GOROOT/bin
echo " " `go version|sed -e s'/go version //' -e s'/ linux.amd64//' -e s'/go/go /'`
fi

if [ -d /usr/local/node.js ]; then
echo "NODE.js configured (local)"
export NODEJS_HOME=/usr/local/node.js/node-v14.15.1-linux-x64
export PATH=$NODEJS_HOME/bin:$PATH
elif [ /usr/bin/node ]; then
echo "NODE.js configured (bin)"
#https://deb.nodesource.com/
echo "  node" `node --version`
echo "  npm" `npm -version`
echo "  tsc" `tsc --version`
fi

if [ -d ~/.cargo ]; then
echo RUST configured
export PATH=$HOME/.cargo/bin:$PATH
echo " " `rustc --version | sed -e 's/ (.*//'`
fi

#if [ -d ~/.local/bin ]; then
#echo PYTHON configured
#export PATH=$HOME/.local/bin:$PATH
#fi

if [ -d ~/.local/bin/julia ]; then
echo JULIA configured
export PATH=$HOME/.local/bin/julia/bin:$PATH
echo " " `julia --version | sed -e s'/version //'`
fi

